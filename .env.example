# Скопируйте файл в .env и замените все значения change-me.
# API-ключ обязателен и должен быть не короче 32 символов. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

DATABASE_URL=postgresql+asyncpg://payments:change-me@localhost:5432/payments
RABBITMQ_URL=amqp://payments:change-me@localhost:25672/

# Swagger UI и /openapi.json отключены по умолчанию; включайте только локально.
ENABLE_DOCS=false

# Пароли PostgreSQL/RabbitMQ. Обязательны и должны быть заменены на свои.
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=change-me

RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=change-me

OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=100

# SSRF-защита webhook. http по умолчанию запрещён; список доверенных хостов
# пуст, поэтому адрес проверяется по результатам DNS-резолвинга. Меняйте
# только для локальных стендов (например, e2e с приёмником в сети compose).
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOWED_HOSTS=
